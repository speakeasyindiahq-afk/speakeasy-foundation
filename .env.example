# Copy this to .env.local and fill in values from your Supabase project.
# Settings → API → URL and anon/public key.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# SERVER-SIDE ONLY. Never expose. Use only in server functions / API routes later.
# SUPABASE_SERVICE_ROLE_KEY=